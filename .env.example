# Application Configuration
APP_NAME="AI Retail Management Platform API"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/quadstock"

# JWT Authentication
# Generate a strong secret key using: openssl rand -hex 32
JWT_SECRET="super-secret-jwt-key-change-this-in-production-32-chars-min"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# Groq Configuration
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL="llama-3.3-70b-versatile"
